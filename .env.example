# development | production. Production refuses to start with the default
# SECRET_KEY or with COOKIE_SECURE=false.
ENVIRONMENT=development

DATABASE_URL=postgresql+psycopg://expense:expense@localhost:5432/expense

# At least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# true behind HTTPS so the auth cookie is never sent over plain HTTP.
COOKIE_SECURE=false

# Demo accounts: deleted after this many hours, at most this many at once.
DEMO_MAX_AGE_HOURS=24
DEMO_MAX_USERS=500
